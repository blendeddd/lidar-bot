+            advice = "Slight overshoot. Acceptable, but halving I will smooth it.";
+        } else {
+            advice = "<b>Good response.</b> Rise under ~0.5s, overshoot under 25%, steady-state within 15%. Press SAVE to write these gains to flash.";
+        }
+
+        var mismatch = Math.abs(Math.abs(L.ss) - Math.abs(R.ss));
+        if (mismatch > Math.abs(pidTestTarget) * 0.2) {
+            advice += "<br>Left and right settle at noticeably different speeds &mdash; check for a binding wheel or a weak motor.";
+        }
+
+        document.getElementById("pidMetrics").innerHTML =
+            "target " + pidTestTarget.toFixed(2) + " m/s<br>" + row("LEFT ", L) + row("RIGHT", R) + "<br>" + advice;
+    }
+
+
+    // --- --- --- auto tuner --- --- ---
+    var autoOn = false;
+    var autoStage = "";
+    var autoP = 0, autoI = 0;
+    var autoBestP = 0;
+    var autoIter = 0;
+    var autoLog = [];
+
+    var AUTO_MAX_ITER   = 18;
+    var AUTO_P_START    = 60;
+    var AUTO_P_MAX      = 3000;
+    var AUTO_I_MAX      = 20000;
+    var OK_OVERSHOOT    = 25;    // %
+    var OK_SS_ERR       = 10;    // %
+    var OK_RISE         = 0.6;   // s
+
+    function autoSay(html) { document.getElementById("pidMetrics").innerHTML = html; }
+
+    function autoTable() {
+        var t = "<table style='font-size:11px;width:100%'><tr style='opacity:.6'>" +
+                "<td>#</td><td>P</td><td>I</td><td>rise</td><td>over%</td><td>ss err%</td><td>osc</td></tr>";
+        for (var i = 0; i < autoLog.length; i++) {
+            var e = autoLog[i];
+            t += "<tr><td>" + (i + 1) + "</td><td>" + e.P + "</td><td>" + e.I + "</td><td>" +
+                 (e.rise === null ? "-" : e.rise.toFixed(2)) + "</td><td>" + e.over.toFixed(0) +
+                 "</td><td>" + e.err.toFixed(0) + "</td><td>" + e.osc + "</td></tr>";
+        }
+        return t + "</table>";
+    }
+
+    // push gains to the board, then run one step test
+    function autoTrial(P, I, done) {
+        if (!autoOn) { return; }
+        document.getElementById("pidP").value = Math.round(P);
+        document.getElementById("pidI").value = Math.round(I);
+        document.getElementById("pidD").value = 0;
+
+        var cmd = {"T":700, "kp": Math.round(P), "ki": Math.round(I), "kd": 0,
+                   "lim": parseFloat(document.getElementById("pidLim").value) || 255, "save": 0};
+        var xhr = new XMLHttpRequest();
+        xhr.onreadystatechange = function() {
+            if (this.readyState == 4) {
+                setTimeout(function() {
+                    if (!autoOn) { return; }
+                    var target = parseFloat(document.getElementById("pidTarget").value) || 0.2;
+                    var hold = parseFloat(document.getElementById("pidHold").value) || 2;
+                    pidRunStep(target, hold, function(L, R) {
+                        if (!autoOn) { return; }
+                        if (!L || !R) { autoFail("No data from the step test."); return; }
+
+                        // judge on the worse wheel
+                        var e = {
+                            P: Math.round(P), I: Math.round(I),
+                            rise: (L.rise === null || R.rise === null) ? null : Math.max(L.rise, R.rise),
+                            over: Math.max(L.overshoot, R.overshoot),
+                            err:  Math.max(Math.abs(L.ssErr), Math.abs(R.ssErr)),
+                            osc:  Math.max(L.osc, R.osc),
+                            ssL: L.ss, ssR: R.ss
+                        };
+                        autoLog.push(e);
+                        autoIter++;
+                        done(e, L, R);
+                    });
+                }, 250);
+            }
+        };
+        xhr.open("GET", "js?json=" + JSON.stringify(cmd), true);
+        xhr.send();
+    }
+
+    function autoFail(msg) {
+        autoOn = false;
+        encStop();
+        autoSay("<b>Auto-tune stopped.</b><br>" + msg + "<br>" + autoTable());
+    }
+
+    function autoStart() {
+        if (autoOn) { return; }
+        autoOn = true;
+        autoLog = [];
+        autoIter = 0;
+        autoP = AUTO_P_START;
+        autoI = 0;
+        autoStage = "check";
+        autoSay("Auto-tune: safety check...");
+        autoTrial(120, 0, autoCheck);
+    }
+
+    function autoAbort() {
+        autoOn = false;
+        encStop();
+        autoSay("Aborted by user.<br>" + autoTable());
+    }
+
+    // stage 1 - is the feedback usable at all?
+    function autoCheck(e, L, R) {
+        var target = parseFloat(document.getElementById("pidTarget").value) || 0.2;
+
+        if (Math.abs(L.ss) < 0.01 && Math.abs(R.ss) < 0.01) {
+            autoFail("No movement measured. Either the wheels are not driving or the encoders are not counting. " +
+                     "Fix that in the encoder test before tuning.");
+            return;
+        }
+        if ((L.ss > 0) != (target > 0) || (R.ss > 0) != (target > 0)) {
+            autoFail("<b>Feedback sign is inverted</b> &mdash; measured speed opposes the command. " +
+                     "Tick FLIP ENCODER for that wheel in the configurator, then run auto-tune again.");
+            return;
+        }
+        autoStage = "findP";
+        autoP = AUTO_P_START;
+        autoSay("Stage 1/3: raising P until it rings...<br>" + autoTable());
+        autoTrial(autoP, 0, autoFindP);
+    }
+
+    // stage 2 - climb P until the response overshoots or oscillates
+    function autoFindP(e) {
+        if (!autoOn) { return; }
+        if (autoIter > AUTO_MAX_ITER) { autoFail("Gave up: too many iterations."); return; }
+
+        var ringing = (e.over > 30) || (e.osc >= 3);
+
+        if (ringing || autoP >= AUTO_P_MAX) {
+            autoBestP = Math.max(AUTO_P_START, autoP * 0.6);   // back off from the ringing point
+            autoStage = "findI";
+            autoI = autoBestP * 0.5;
+            autoSay("Stage 2/3: P settled at " + Math.round(autoBestP) + ", now raising I...<br>" + autoTable());
+            autoTrial(autoBestP, autoI, autoFindI);
+            return;
+        }
+
+        autoP = autoP * 1.7;
+        autoSay("Stage 1/3: P = " + Math.round(autoP) + "...<br>" + autoTable());
+        autoTrial(autoP, 0, autoFindP);
+    }
+
+    // stage 3 - climb I until steady-state error is gone, then back off
+    function autoFindI(e) {
+        if (!autoOn) { return; }
+        if (autoIter > AUTO_MAX_ITER) { autoFail("Gave up: too many iterations."); return; }
+
+        var tooMuch = (e.over > 45) || (e.osc >= 4);
+        var goodEnough = (e.err <= OK_SS_ERR) && (e.over <= OK_OVERSHOOT);
+
+        if (tooMuch) {
+            autoI = autoI * 0.5;
+            autoStage = "verify";
+            autoSay("Stage 3/3: backing I off to " + Math.round(autoI) + " and verifying...<br>" + autoTable());
+            autoTrial(autoBestP, autoI, autoVerify);
+            return;
+        }
+        if (goodEnough || autoI >= AUTO_I_MAX) {
+            autoStage = "verify";
+            autoSay("Stage 3/3: verifying P=" + Math.round(autoBestP) + " I=" + Math.round(autoI) + "...<br>" + autoTable());
+            autoTrial(autoBestP, autoI, autoVerify);
+            return;
+        }
+
+        autoI = (autoI < 1) ? 50 : autoI * 2;
+        autoSay("Stage 2/3: I = " + Math.round(autoI) + "...<br>" + autoTable());
+        autoTrial(autoBestP, autoI, autoFindI);
+    }
+
+    function autoVerify(e) {
+        autoOn = false;
+        encStop();
+
+        var pass = (e.over <= OK_OVERSHOOT) && (e.err <= OK_SS_ERR) &&
+                   (e.rise !== null && e.rise <= OK_RISE);
+
+        var msg = "<b>Auto-tune finished.</b><br>" +
+                  "P = <b>" + Math.round(autoBestP) + "</b>, I = <b>" + Math.round(autoI) + "</b>, D = 0<br>" +
+                  "rise " + (e.rise === null ? "n/a" : e.rise.toFixed(2) + "s") +
+                  ", overshoot " + e.over.toFixed(0) + "%, steady-state error " + e.err.toFixed(0) + "%<br>";
+
+        msg += pass
+            ? "Meets the targets (rise &lt;" + OK_RISE + "s, overshoot &lt;" + OK_OVERSHOOT +
+              "%, error &lt;" + OK_SS_ERR + "%). Press SAVE to keep these gains.<br>"
+            : "Close but outside targets &mdash; usable, but a manual nudge may improve it. " +
+              "Press SAVE to keep, or adjust by hand and STEP TEST.<br>";
+
+        msg += "<br>" + autoTable();
+        autoSay(msg);
+    }
+
+    pidReadCfg();
 </script>
 </body>
 </html>
