+        // scale
+        var mx = 0.05;
+        for (var i = 0; i < pidBuf.length; i++) {
+            var p = pidBuf[i];
+            mx = Math.max(mx, Math.abs(p.sL), Math.abs(p.mL), Math.abs(p.sR), Math.abs(p.mR));
+        }
+        mx = mx * 1.25;
