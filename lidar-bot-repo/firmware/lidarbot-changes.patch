\ No newline at end of file
+}
+
+// --- --- --- pack voltage monitor (second INA219) --- --- ---
+// Wiring: VIN+ and VIN- both tied to battery positive, so no load current
+// passes through the shunt; bus voltage still reads raw pack voltage.
+// Module default address is 0x40 (bridge A0 for 0x41). Onboard INA219 is 0x42.
+#define PACK_INA219_ADDRESS 0x41
+
+// Ozito PXC 18V pack (5S li-ion): ~21.0V full, ~15.0V empty.
+#define PACK_LOW_VOLTAGE     15.5   // flag low below this
+#define PACK_RECOVER_VOLTAGE 16.0   // clear the flag above this (hysteresis)
+
+// Active buzzer on low battery. Set to a free, broken-out GPIO to enable;
+// -1 leaves it disabled.
+#define PACK_BUZZER_PIN -1
+
+INA219_WE packIna219 = INA219_WE(PACK_INA219_ADDRESS);
+
+float packVoltage_V = 0.0;
+float packCurrent_mA = 0.0;
+bool  packMonitorOnline = false;
+bool  packLowVoltage = false;
+
+void packMonitorInit(){
+  packMonitorOnline = packIna219.init();
+  if(!packMonitorOnline){
+    Serial.println("Pack INA219 not connected!");
+    return;
+  }
+  packIna219.setADCMode(BIT_MODE_9);
+  packIna219.setPGain(PG_320);
+  packIna219.setBusRange(BRNG_32);      // pack reaches 21V, needs the 32V range
+  packIna219.setShuntSizeInOhms(0.1);
+  if(PACK_BUZZER_PIN >= 0){
+    pinMode(PACK_BUZZER_PIN, OUTPUT);
+    digitalWrite(PACK_BUZZER_PIN, LOW);
+  }
+}
+
+void packDataUpdate(){
+  if(!packMonitorOnline){
+    return;
+  }
+  packVoltage_V = packIna219.getBusVoltage_V();
+  packCurrent_mA = packIna219.getCurrent_mA();
+
+  if(!packLowVoltage && packVoltage_V < PACK_LOW_VOLTAGE){
+    packLowVoltage = true;
+    Serial.println("Battery low!");
+  } else if(packLowVoltage && packVoltage_V > PACK_RECOVER_VOLTAGE){
+    packLowVoltage = false;
+  }
+
+  if(PACK_BUZZER_PIN >= 0){
+    digitalWrite(PACK_BUZZER_PIN, packLowVoltage ? HIGH : LOW);
+  }
+}
+
+// short suffix for the oled line
+String packStatusStr(){
+  if(!packMonitorOnline){
+    return "";
+  }
+  if(packLowVoltage){
+    return " BAT LOW!";
+  }
+  return " B:" + String(packVoltage_V, 1);
+}
+
+
+// --- --- --- pack state of charge --- --- ---
+// li-ion discharge curve, per cell. 5 cells in series (Ozito PXC 18V).
+#define PACK_CELLS 5
+
+int packPercent(){
+  if(!packMonitorOnline){
+    return -1;
+  }
+  static const float curveV[] = {4.20,4.15,4.11,4.08,4.02,3.98,3.95,3.91,3.87,
+                                 3.85,3.84,3.82,3.80,3.79,3.77,3.75,3.73,3.71,
+                                 3.69,3.61,3.27};
+  static const int   curveP[] = {100,95,90,85,80,75,70,65,60,
+                                 55,50,45,40,35,30,25,20,15,
+                                 10,5,0};
+  const int n = sizeof(curveP)/sizeof(curveP[0]);
+
+  float cell = packVoltage_V / PACK_CELLS;
+
+  if(cell >= curveV[0])   return 100;
+  if(cell <= curveV[n-1]) return 0;
+
+  for(int i = 1; i < n; i++){
+    if(cell >= curveV[i]){
+      float span = curveV[i-1] - curveV[i];
+      float frac = (cell - curveV[i]) / span;
+      return curveP[i] + (int)(frac * (curveP[i-1] - curveP[i]));
+    }
+  }
+  return 0;
+}
