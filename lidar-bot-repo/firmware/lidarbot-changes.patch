+        var l, r;
+        if (step.type == "F") {
+            var sign = step.val >= 0 ? 1 : -1;
+            l = s * sign; r = s * sign;
+        } else {
+            var sign2 = step.val >= 0 ? 1 : -1;   // + = right / clockwise
+            l = s * sign2; r = -s * sign2;
+        }
