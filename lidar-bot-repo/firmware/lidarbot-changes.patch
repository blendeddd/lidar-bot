+        var ppr = parseFloat(document.getElementById("cfgPPR").value) || 1;
+        var tw  = parseFloat(document.getElementById("cfgTW").value)  || 1;
+        var circ = Math.PI * dia;
+        if (step.type == "F") {
+            return Math.abs(step.val) / circ * ppr;
