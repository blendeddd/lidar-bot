+                msg += "LEFT counted backwards &mdash; swap left encoder A/B (or its motor wires if the wheel span the wrong way).";
+            } else if (!okR) {
+                msg += "RIGHT counted backwards &mdash; swap right encoder A/B (or its motor wires if the wheel span the wrong way).";
+            } else {
