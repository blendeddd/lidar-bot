+        var peak = 0, rise = null, i;
+        for (i = 0; i < pidTestData.length; i++) {
+            var v = pidTestData[i][key];
+            if (Math.abs(v) > Math.abs(peak)) { peak = v; }
+            if (rise === null && Math.abs(v) >= Math.abs(t) * 0.9) { rise = pidTestData[i].t; }
